# RTSP Camera Viewer Environment Configuration Template
# Copy this file to .env and fill in your NVR / IP Camera details:
#   cp .env.example .env && chmod 600 .env

# NVR / Camera Brand Template: "dahua" (Dahua/CP Plus/Amcrest), "hikvision", or "custom"
RTSP_BRAND="dahua"

# Primary LAN Host / IP of your NVR or DVR
RTSP_HOST="192.168.1.100"

# Optional Dahua / CP Plus / Amcrest P2P Serial Number (S/N) for zero-config access over ANY internet connection
# When set, the viewer automatically tunnels via Cloud P2P if your LAN NVR IP is unreachable!
RTSP_P2P_SERIAL="YOUR_NVR_SERIAL_NUMBER"
RTSP_USE_CLOUD_P2P="false"

# Optional Tailscale / Remote VPN Host or Subnet-Routed IP for 1-click remote switching
RTSP_TAILSCALE_HOST="100.x.y.z"
RTSP_USE_TAILSCALE="false"

# RTSP Port (default: 554)
RTSP_PORT="554"

# RTSP Credentials
RTSP_USER="admin"
RTSP_PASSWORD="your_password_here"

# Total number of camera channels to display (1-32, default: 12 for 3x4 grid)
NUM_CAMERAS="12"

# Starting channel index for IP cameras on hybrid XVR/NVR systems
IP_CAMERA_START_CHANNEL="10"

# Default stream quality in Grid View: "1" = Sub-Stream (SD, low bandwidth), "0" = Main Stream (HD)
DEFAULT_SUBTYPE="1"

# Hardware Decode Mode: "auto" (VAAPI/NVDEC with CPU fallback) or "software"
HWACCEL_MODE="auto"

# Optional Custom RTSP URL Template (used when RTSP_BRAND="custom")
# Placeholders: {user}, {password}, {host}, {port}, {channel}, {subtype}
# RTSP_CUSTOM_URL_TEMPLATE="rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype={subtype}"
